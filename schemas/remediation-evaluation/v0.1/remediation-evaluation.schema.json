{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://fas-bench.dev/schemas/remediation-evaluation/v0.1/remediation-evaluation.schema.json",
  "title":"FAS-Bench Remediation Evaluation v0.1",
  "type":"object",
  "properties":{
    "remediation_id":{"$ref":"../../common/v0.1/common.schema.json#/$defs/RemediationId"},
    "case_id":{"$ref":"../../common/v0.1/common.schema.json#/$defs/CaseId"},
    "benchmark_version":{"$ref":"../../common/v0.1/common.schema.json#/$defs/BenchmarkVersion"},
    "schema_version":{"$ref":"../../common/v0.1/common.schema.json#/$defs/SchemaVersion"},
    "status":{"type":"string","enum":["REMEDIATED","REMEDIATION_FAILED","CONDITIONALLY_REMEDIATED","REGRESSED","UNKNOWN","BENCHMARK_ERROR"]},
    "original_condition_status":{"type":"string","minLength":1},
    "path_status":{"type":"string","enum":["REMOVED","PERSISTING","UNKNOWN"]},
    "alternate_path_status":{"type":"string","enum":["CLOSED","REMAINS","UNKNOWN"]},
    "security_test_status":{"type":"string","enum":["PASS","FAIL","UNRESOLVED","NOT_ASSESSED"]},
    "functional_test_status":{"type":"string","enum":["PASS","FAIL","UNRESOLVED","NOT_ASSESSED"]},
    "regression_status":{"type":"string","enum":["PASS","FAIL","UNRESOLVED","NOT_ASSESSED"]},
    "new_findings_status":{"type":"string","enum":["PASS","FAIL","UNRESOLVED","NOT_ASSESSED"]},
    "evidence_integrity":{"type":"string","enum":["VERIFIED","INVALID","UNRESOLVED"]},
    "path_lifecycles":{"type":"array","items":{"type":"object","required":["path_id","lifecycle"],"properties":{"path_id":{"type":"string"},"lifecycle":{"type":"string"},"before_status":{"type":["string","null"]},"after_status":{"type":["string","null"]},"equivalent_path_id":{"type":["string","null"]},"reason":{"type":"string"}},"additionalProperties":false}},
    "alternate_paths":{"type":"array","items":{"type":"object","required":["path_id","classification"],"properties":{"path_id":{"type":"string"},"classification":{"type":"string"},"impact_key":{"type":"string"},"entry_key":{"type":"string"},"reason":{"type":"string"}},"additionalProperties":false}},
    "graph_diff":{"type":"object","additionalProperties":true},
    "security_condition_diff":{"type":"object","additionalProperties":true},
    "security_controls":{"type":"object","additionalProperties":true},
    "security_tests":{"type":"array","items":{"type":"object","additionalProperties":true}},
    "functional_tests":{"type":"array","items":{"type":"object","additionalProperties":true}},
    "regression_tests":{"type":"array","items":{"type":"object","additionalProperties":true}},
    "new_finding_tests":{"type":"array","items":{"type":"object","additionalProperties":true}},
    "dimensions":{"type":"object","additionalProperties":{"type":"number","minimum":0,"maximum":1}},
    "score":{"type":"number","minimum":0,"maximum":1},
    "diagnostics":{"type":"array","items":{"type":"string"}},
    "provenance":{"type":"object","additionalProperties":{"type":"string"}}
  },
  "required":["remediation_id","case_id","benchmark_version","schema_version","status","original_condition_status","path_status","alternate_path_status","security_test_status","functional_test_status","regression_status","new_findings_status","evidence_integrity","path_lifecycles","alternate_paths","graph_diff","security_condition_diff","security_controls","dimensions","diagnostics","provenance"],
  "additionalProperties":false
}