{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fas-bench.dev/schemas/evaluation-result/v0.1/evaluation-result.schema.json",
  "title": "FAS-Bench Evaluation Result v0.1",
  "type": "object",
  "properties": {
    "evaluation_phase": {"type": "string", "minLength": 1},
    "evaluation_id": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/EvaluationId"
    },
    "benchmark_version": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/BenchmarkVersion"
    },
    "schema_version": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/SchemaVersion"
    },
    "submission_id": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/SubmissionId"
    },
    "case_id": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/CaseId"
    },
    "validity": {
      "type": "string",
      "enum": [
        "VALID",
        "SCHEMA_INVALID",
        "SEMANTIC_INVALID",
        "BENCHMARK_INVALID"
      ]
    },
    "finding_score": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/ScoreComponent"
    },
    "verdict_score": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/ScoreComponent"
    },
    "evidence_score": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/ScoreComponent"
    },
    "reachability_score": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/ScoreComponent"
    },
    "attack_path_score": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/ScoreComponent"
    },
    "impact_score": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/ScoreComponent"
    },
    "remediation_score": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/ScoreComponent"
    },
    "calibration_score": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/ScoreComponent"
    },
    "efficiency_score": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/ScoreComponent"
    },
    "integrity": {
      "type": "object",
      "properties": {
        "evidence_integrity_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "score_cap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "invalidity_reason": {
          "$ref": "../../common/v0.1/common.schema.json#/$defs/ErrorCode"
        }
      },
      "additionalProperties": false
    },
    "final_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cap": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "penalty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "expected_verdict": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/Verdict"
    },
    "finding_evaluation": {
      "type": "object",
      "properties": {
        "finding_id": {"$ref": "../../common/v0.1/common.schema.json#/$defs/FindingId"},
        "matched": {"type": "boolean"},
        "category_supported": {"type": "boolean"},
        "claims_supported": {"type": "boolean"},
        "evidence_supported": {"type": "boolean"},
        "verdict_claimed": {"$ref": "../../common/v0.1/common.schema.json#/$defs/Verdict"},
        "expected_verdict": {"$ref": "../../common/v0.1/common.schema.json#/$defs/Verdict"},
        "reason_code": {"$ref": "../../common/v0.1/common.schema.json#/$defs/ReasonCode"},
        "details": {"type": "string"}
      },
      "required": ["finding_id","matched","category_supported","claims_supported","evidence_supported","verdict_claimed","expected_verdict","reason_code"],
      "additionalProperties": false
    },
    "claim_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {"$ref": "../../common/v0.1/common.schema.json#/$defs/ClaimId"},
          "expected_claim_id": {"$ref": "../../common/v0.1/common.schema.json#/$defs/ClaimId"},
          "status": {"type": "string","enum": ["VERIFIED","INVALID","UNRESOLVED","CONTRADICTED","MISSING"]},
          "reason_code": {"$ref": "../../common/v0.1/common.schema.json#/$defs/ReasonCode"},
          "evidence_ids": {"$ref": "../../common/v0.1/common.schema.json#/$defs/EvidenceRef"},
          "details": {"type": "string"}
        },
        "required": ["claim_id","status","reason_code","evidence_ids"],
        "additionalProperties": false
      }
    },
    "security_condition": {
      "type": "object",
      "properties": {
        "path_id": {"$ref": "../../common/v0.1/common.schema.json#/$defs/PathId"},
        "path_status": {"$ref": "../../common/v0.1/common.schema.json#/$defs/PathStatus"},
        "security_property": {"type": "string","minLength": 1},
        "effective_control_state": {"type": "string","enum": ["EFFECTIVE","INEFFECTIVE_OR_BYPASSED","NOT_RELEVANT","UNKNOWN"]},
        "required_conditions": {"type": "array","items":{"type":"string"}},
        "satisfied_conditions": {"type": "array","items":{"type":"string"}},
        "unsatisfied_conditions": {"type": "array","items":{"type":"string"}},
        "unknown_conditions": {"type": "array","items":{"type":"string"}}
      },
      "required": ["path_id","path_status","security_property","effective_control_state","required_conditions","satisfied_conditions","unsatisfied_conditions","unknown_conditions"],
      "additionalProperties": false
    },
    "verdict_evaluation": {
      "type": "object",
      "properties": {
        "submitted": {"$ref": "../../common/v0.1/common.schema.json#/$defs/Verdict"},
        "expected": {"$ref": "../../common/v0.1/common.schema.json#/$defs/Verdict"},
        "verdict_correct": {"type": "boolean"},
        "verdict_supported": {"type": "boolean"},
        "reason_code": {"$ref": "../../common/v0.1/common.schema.json#/$defs/ReasonCode"},
        "supporting_claims": {"$ref": "../../common/v0.1/common.schema.json#/$defs/ClaimRef"},
        "blocking_claims": {"$ref": "../../common/v0.1/common.schema.json#/$defs/ClaimRef"},
        "required_conditions": {"type": "array","items":{"type":"string"}},
        "satisfied_conditions": {"type": "array","items":{"type":"string"}},
        "unsatisfied_conditions": {"type": "array","items":{"type":"string"}},
        "evidence_ids": {"$ref": "../../common/v0.1/common.schema.json#/$defs/EvidenceRef"},
        "details": {"type":"string"}
      },
      "required": ["submitted","expected","verdict_correct","verdict_supported","reason_code","supporting_claims","blocking_claims","required_conditions","satisfied_conditions","unsatisfied_conditions","evidence_ids"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "submitted_evidence_count": {"type":"integer","minimum":0},
        "verified_evidence_count": {"type":"integer","minimum":0},
        "invalid_evidence_count": {"type":"integer","minimum":0},
        "unresolved_evidence_count": {"type":"integer","minimum":0},
        "contradicted_evidence_count": {"type":"integer","minimum":0},
        "missing_expected_evidence_count": {"type":"integer","minimum":0},
        "duplicate_evidence_count": {"type":"integer","minimum":0},
        "evidence_hallucination_rate": {"type":"number","minimum":0,"maximum":1},
        "coverage": {"type":"number","minimum":0,"maximum":1},
        "result_hash": {"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}
      },
      "required": ["submitted_evidence_count","verified_evidence_count","invalid_evidence_count","unresolved_evidence_count","contradicted_evidence_count","missing_expected_evidence_count","duplicate_evidence_count","evidence_hallucination_rate","coverage","result_hash"],
      "additionalProperties": false
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "../../common/v0.1/common.schema.json#/$defs/ErrorCode"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "schema_location": {
            "type": "string"
          },
          "instance_location": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "evaluation_id",
    "benchmark_version",
    "schema_version",
    "submission_id",
    "case_id",
    "validity",
    "expected_verdict",
    "finding_evaluation",
    "claim_evaluations",
    "security_condition",
    "verdict_evaluation",
    "evidence",
    "fingerprint",
    "errors",
    "warnings"
  ],
  "additionalProperties": false
}