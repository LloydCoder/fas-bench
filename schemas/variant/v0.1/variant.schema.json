{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://fas-bench.dev/schemas/variant/v0.1/variant.schema.json","type":"object","additionalProperties":false,"required":["variant_id","parent_case_id","variant_type","mutation_chain","semantic_relation","expected_security_relation","artifact_digest","validation_status"],"properties":{"variant_id":{"type":"string"},"parent_case_id":{"type":"string","pattern":"^FAS-[0-9]{3}$"},"variant_type":{"type":"string"},"mutation_chain":{"type":"array","items":{"type":"string"}},"semantic_relation":{"enum":["SEMANTICALLY_EQUIVALENT","SECURITY_WEAKENED","SECURITY_STRENGTHENED","ALTERNATE_PATH_INTRODUCED","CONTROL_REMOVED","CONTROL_ADDED","REMEDIATION_INVALIDATED"]},"expected_security_relation":{"type":"string"},"artifact_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"validation_status":{"enum":["VALIDATED","REJECTED","INVALID"]}}}