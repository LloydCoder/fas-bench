{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://fas-bench.dev/schemas/execution-result/v0.1/execution-result.schema.json",
 "title":"FAS-Bench Secure Execution Result v0.1","type":"object","additionalProperties":false,
 "properties":{
  "status":{"type":"string","enum":["SUCCESS","FAILED","TIMEOUT","OUTPUT_LIMIT","RESOURCE_LIMIT","SECURITY_VIOLATION","EVALUATOR_ERROR"]},
  "failure_code":{"type":["string","null"]},"exit_code":{"type":["integer","null"]},
  "started_at":{"type":"string"},"finished_at":{"type":"string"},"duration_seconds":{"type":"number","minimum":0},
  "stdout":{"type":"string"},"stderr":{"type":"string"},"stdout_truncated":{"type":"boolean"},"stderr_truncated":{"type":"boolean"},
  "artifacts":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"size":{"type":"integer","minimum":0},"type":{"type":"string"},"producer":{"type":"string"},"trust_level":{"type":"string"}},"required":["path","sha256","size","type","producer","trust_level"]}},
  "manifest_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"run_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"policy":{"type":"object"},"input_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "cleanup_ok":{"type":"boolean"},"container_digest":{"type":["string","null"]},"security_events":{"type":"array"},"attempt_id":{"type":"string"}
 },
 "required":["status","failure_code","exit_code","started_at","finished_at","duration_seconds","stdout","stderr","stdout_truncated","stderr_truncated","artifacts","manifest_sha256","run_id","policy","input_digest","cleanup_ok","container_digest","security_events","attempt_id"]
}