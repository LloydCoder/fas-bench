{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fas-bench.dev/schemas/case/v0.1/case.schema.json",
  "title": "FAS-Bench Case v0.1",
  "type": "object",
  "properties": {
    "case_id": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/CaseId"
    },
    "benchmark_version": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/BenchmarkVersion"
    },
    "schema_version": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/SchemaVersion"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/Category"
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "../../common/v0.1/common.schema.json#/$defs/Category"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "difficulty": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/Difficulty"
    },
    "status": {
      "$ref": "../../common/v0.1/common.schema.json#/$defs/CaseStatus"
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "security_condition": {
      "type": "string",
      "minLength": 1
    },
    "attacker_model": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    },
    "repository": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri-reference"
        },
        "commit": {
          "type": "string"
        },
        "artifact_digest": {
          "$ref": "../../common/v0.1/common.schema.json#/$defs/ArtifactDigest"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "case_id",
    "benchmark_version",
    "schema_version",
    "title",
    "description",
    "category",
    "categories",
    "difficulty",
    "status",
    "scenario",
    "security_condition",
    "attacker_model"
  ],
  "additionalProperties": false
}