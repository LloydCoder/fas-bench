{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://fas-bench.dev/schemas/mutation/v0.1/mutation.schema.json","type":"object","additionalProperties":false,"required":["mutation_id","operator","input_case","output_variant","semantic_class","expected_security_delta","expected_verdict_delta","validation_status","artifact_digest"],"properties":{"mutation_id":{"type":"string","minLength":1},"operator":{"type":"string","minLength":1},"input_case":{"type":"string","pattern":"^FAS-[0-9]{3}$"},"output_variant":{"type":"string","minLength":1},"semantic_class":{"enum":["SEMANTICALLY_EQUIVALENT","SECURITY_WEAKENED","SECURITY_STRENGTHENED","ALTERNATE_PATH_INTRODUCED","CONTROL_REMOVED","CONTROL_ADDED","REMEDIATION_INVALIDATED","INVALID"]},"expected_security_delta":{"type":"string"},"expected_verdict_delta":{"type":"string"},"validation_status":{"enum":["VALIDATED","MUTATION_VALIDATION_FAILURE","INVALID"]},"artifact_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}