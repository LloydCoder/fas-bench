{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://fas-bench.dev/schemas/release-manifest/v0.1/release-manifest.schema.json","type":"object","additionalProperties":false,"required":["manifest_version","release_version","benchmark_version","schema_versions","channel","case_ids","case_versions","case_digests","fixture_digests","oracle_digests","component_digests","mutation_version","provenance","validation_status","hidden_ground_truth","release_digest_algorithm","release_digest_domain","release_digest"],"properties":{"manifest_version":{"type":"string"},"release_version":{"type":"string"},"benchmark_version":{"type":"string"},"schema_versions":{"type":"object"},"channel":{"enum":["development","release-candidate","public","official"]},"case_ids":{"type":"array","items":{"type":"string","pattern":"^FAS-[0-9]{3}$"}},"case_versions":{"type":"object","additionalProperties":{"type":"string"}},"case_digests":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"fixture_digests":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"oracle_digests":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"component_digests":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"mutation_version":{"type":"string"},"provenance":{"type":"object"},"validation_status":{"enum":["VALIDATED","INVALID"]},"hidden_ground_truth":{"type":"boolean"},"release_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"release_digest_algorithm":{"type":"string","const":"SHA-256"},"release_digest_domain":{"type":"string","const":"FAS-BENCH-MANIFEST-V1"}}}