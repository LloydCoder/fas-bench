{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://fas-bench.dev/schemas/contamination/v0.1/contamination.schema.json","type":"object","additionalProperties":false,"required":["status","evaluation_mode","network_policy","external_lookup_allowed","hidden_set_used","case_population_digest"],"properties":{"status":{"enum":["KNOWN","SUSPECTED","UNKNOWN","NOT_ASSESSED"]},"evaluation_mode":{"enum":["development","practice","official"]},"network_policy":{"type":"string"},"external_lookup_allowed":{"type":"boolean"},"hidden_set_used":{"type":"boolean"},"case_population_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}