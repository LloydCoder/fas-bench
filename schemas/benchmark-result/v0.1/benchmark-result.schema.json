{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://fas-bench.dev/schemas/benchmark-result/v0.1/benchmark-result.schema.json","title":"FAS-Bench Benchmark Measurement Result v0.1","type":"object","additionalProperties":false,"properties":{"report_schema_version":{"type":"string","const":"0.1"},"benchmark_version":{"type":"string"},"evaluator_version":{"type":"string"},"scoring_version":{"type":"string"},"run_id":{"type":"string","minLength":1},"case_results":{"type":"array","items":{"type":"object"}},"aggregate_metrics":{"type":"object"},"configuration":{"type":"object"},"uncertainty":{"type":"object"},"result_digest":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}},"required":["report_schema_version","benchmark_version","evaluator_version","scoring_version","run_id","case_results","aggregate_metrics","configuration","uncertainty","result_digest"]}